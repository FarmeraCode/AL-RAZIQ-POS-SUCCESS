# Optional — durable shared storage for /api/state.
#
# Create a Redis (Upstash) database in the Vercel dashboard under
# Storage → Create Database and connect it to this project; Vercel injects these
# automatically and nothing else needs to change.
#
# Without them the app still runs: locally it stores shared state in
# .pos-data/state.json, and on a deploy it falls back to per-instance memory.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Aliases that are also accepted:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
